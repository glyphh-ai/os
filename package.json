{
  "name": "@glyphh-ai/os",
  "version": "0.1.0",
  "productName": "Glyphh OS",
  "description": "Glyphh OS — an AI operating system: a talking Claude at the center, every tool around it.",
  "license": "MIT",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "three": "^0.187.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "electron": "^42.11.18",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "node-pty@1.1.0": true,
    "electron@42.11.18": true
  }
}
